<rml>
  <head>
    <title>ZigCraft Resource Packs</title>
    <link type="text/rcss" href="menu.rcss" />
  </head>
  <body>
    <div class="page">
      <div class="shell medium">
        <div class="header">
          <div class="kicker">ASSETS</div>
          <h1>Resource Packs</h1>
          <p class="copy">Choose the block texture pack used by your worlds. Changes apply immediately.</p>
          <div id="status" class="header-meta">READY</div>
        </div>
        <div class="content">
          <div class="pane">
            <div class="pane-header"><span class="section-label">AVAILABLE PACKS</span></div>
            <div id="pack-list" class="pane-body"></div>
          </div>
        </div>
        <div class="footer">
          <span class="status">Your selection is saved immediately.</span>
          <div class="footer-right"><button id="back">BACK</button></div>
        </div>
      </div>
    </div>
  </body>
</rml>
